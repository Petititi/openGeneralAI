  "version": "0.2.0",
  "configurations": [

    {
      "name": "Run server",
      "type": "debugpy",
      "request": "launch",
      "module": "app",
      "justMyCode": false
    },
    {
      "name": "Python: Debug dernier test pytest",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "args": [
        "--last-failed"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Python: index code",
      "type": "python",
      "request": "launch",
      "module": "agents.tools.longterm_memory",
      "args": [
        "index","C:/Research/LLM/openGeneralAI"
      ],
      "console": "integratedTerminal"
    },
  ]
}